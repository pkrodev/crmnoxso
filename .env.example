# NOXSO CRM — wzór konfiguracji.
# Skopiuj do pliku .env i uzupełnij. Plik .env NIE trafia do repozytorium.

# --- podstawy ---------------------------------------------------------------
FLASK_ENV=development
# Losowy ciąg, minimum 32 bajty. Wygenerujesz go poleceniem:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
TZ=Europe/Warsaw

# --- baza danych ------------------------------------------------------------
# Lokalnie (po instalacji PostgreSQL 16):
DATABASE_URL=postgresql+psycopg://postgres:TWOJE_HASLO@localhost:5432/noxso_crm
# Na Railwayu zmienna przychodzi z prefiksem postgres:// — aplikacja sama
# podmienia go na postgresql+psycopg://, więc możesz wkleić ją bez zmian.

# Baza używana przez testy integracyjne (pytest)
TEST_DATABASE_URL=postgresql+psycopg://postgres:TWOJE_HASLO@localhost:5432/noxso_crm_test

# --- logowanie --------------------------------------------------------------
ADMIN_LOGIN=Milosz
# Hash wygenerujesz poleceniem: python scripts/hash_password.py
# Samego hasła nie wpisuj tu NIGDY.
ADMIN_PASSWORD_HASH=

# --- SMS (etap 7) -----------------------------------------------------------
SMS_PROVIDER=smsplanet
# Panel klienta SMSPlanet → API → Tokeny API
SMSPLANET_TOKEN=
# Panel klienta SMSPlanet → API → Webhooki (klucz do podpisu HMAC)
SMSPLANET_SIGNATURE_KEY=
# Maksymalnie 11 znaków. Do czasu akceptacji pola nadawcy zostaw TEST.
SMS_SENDER_NAME=TEST

# --- AI (etap 5) ------------------------------------------------------------
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat

# --- endpoint transkrypcji (etap 4) -----------------------------------------
# Token dla osoby wrzucającej nagrania. Wygeneruj tak samo jak SECRET_KEY.
INGEST_TOKEN=

# --- zadania w tle ----------------------------------------------------------
# 0 wyłącza APScheduler (przydatne, gdy uruchamiasz kilka procesów)
SCHEDULER_ENABLED=1
